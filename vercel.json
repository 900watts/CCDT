{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "rewrites": [
    { "source": "/llms.txt",       "dest": "/api/index.js" },
    { "source": "/llms-full.txt",  "dest": "/api/index.js" },
    { "source": "/sitemap.xml",    "dest": "/api/index.js" },
    { "source": "/(.*)",           "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(api/.*|llms\\.txt|llms-full\\.txt|sitemap\\.xml)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, User-Agent" }
      ]
    }
  ]
}
